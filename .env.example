# ==============================================================================
# Environment Configuration Template (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế trước khi chạy:
#   cp .env.example .env
# ==============================================================================

# Flask Runtime Environment ('production' hoặc 'development')
FLASK_ENV=production

# Khóa bí mật ứng dụng (Bắt buộc trong production - tối thiểu 32 ký tự ngẫu nhiên)
# Tạo nhanh bằng lệnh: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_and_paste_a_secure_random_key_here

# Mật khẩu khởi tạo tài khoản quản trị khi chạy scripts/seed_db.py
ADMIN_INITIAL_PASSWORD=ChangeThisStrongAdminPassword@2024!

# Bảo mật Session Cookie:
# - True: Bắt buộc khi triển khai Production thực tế chạy qua HTTPS
# - False: Dành cho môi trường Lab / Local chạy qua HTTP (http://localhost:5000)
SESSION_COOKIE_SECURE=False

# Đường dẫn cơ sở dữ liệu
DATABASE_URL=sqlite:///app.db
